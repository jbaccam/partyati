-- Archived v1 layout; superseded by movement blockout.
-- Run in a separate place. The root Copy The Scene project does not include this.
if workspace:FindFirstChild("FacilityLayoutReview") then return end
local root = Instance.new("Model")
root.Name = "FacilityLayoutReview"
local wallHeight = 12
local wallColor = Color3.fromRGB(150, 153, 155)

local function part(parent, name, size, position, color)
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.Size = size
	p.Position = position
	p.Color = color or wallColor
	p.Material = Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = parent
	return p
end

-- Door gaps are eight studs wide and ten studs high, with visible lintels.
local function wall(parent, name, cx, cz, length, horizontal, hasDoor)
	local function segment(suffix, offset, width, height, y)
		return part(parent, name .. suffix,
			horizontal and Vector3.new(width, height, 1) or Vector3.new(1, height, width),
			Vector3.new(cx + (horizontal and offset or 0), y, cz + (horizontal and 0 or offset)))
	end
	if hasDoor then
		local span = (length - 8) / 2
		segment("Left", -(4 + span / 2), span, wallHeight, wallHeight / 2)
		segment("Right", 4 + span / 2, span, wallHeight, wallHeight / 2)
		segment("Lintel", 0, 8, 2, 11)
	else
		segment("", 0, length, wallHeight, wallHeight / 2)
	end
end

local rooms = {
	-- name, center x/z, width/depth, inward-facing doorway
	{"Admin", -22, -68, 40, 48, "South"},
	{"Medical", 22, -68, 40, 48, "South"},
	{"ResidentialA", -68, -22, 48, 40, "East"},
	{"ResidentialB", -68, 22, 48, 40, "East"},
	{"Library", 68, -22, 48, 40, "West"},
	{"Storage", 68, 22, 48, 40, "West"},
	{"Entry", -22, 68, 40, 48, "North"},
	{"Security", 22, 68, 40, 48, "North"},
}

for _, r in rooms do
	local name, x, z, w, d, doorway = table.unpack(r)
	local room = Instance.new("Model")
	room.Name = name
	room.Parent = root
	room:SetAttribute("ReviewStage", "LayoutOnly")
	part(room, "Floor", Vector3.new(w, 1, d), Vector3.new(x, -0.5, z), Color3.fromRGB(105, 112, 118))
	wall(room, "North", x, z - d/2, w, true, doorway == "North")
	wall(room, "South", x, z + d/2, w, true, doorway == "South" or name == "Entry")
	wall(room, "West", x - w/2, z, d, false, doorway == "West")
	wall(room, "East", x + w/2, z, d, false, doorway == "East")
end

local circulation = Instance.new("Model")
circulation.Name = "CourtyardLoop"
circulation.Parent = root
local floorColor = Color3.fromRGB(129, 133, 137)
part(circulation, "NorthHall", Vector3.new(88,1,12), Vector3.new(0,-0.5,-38), floorColor)
part(circulation, "SouthHall", Vector3.new(88,1,12), Vector3.new(0,-0.5,38), floorColor)
part(circulation, "WestHall", Vector3.new(12,1,64), Vector3.new(-38,-0.5,0), floorColor)
part(circulation, "EastHall", Vector3.new(12,1,64), Vector3.new(38,-0.5,0), floorColor)
part(circulation, "Courtyard", Vector3.new(64,1,64), Vector3.new(0,-0.5,0), Color3.fromRGB(108,122,112))
wall(circulation, "CourtyardNorth", 0,-32,64,true,false)
wall(circulation, "CourtyardSouth", 0,32,64,true,true)
wall(circulation, "CourtyardWest", -32,0,64,false,true)
wall(circulation, "CourtyardEast", 32,0,64,false,true)
-- Close the small gaps between room pairs and around corridor corners.
for _, z in {-44,44} do
	for _, x in {-43,0,43} do
		wall(circulation,"HallEnd",x,z,x == 0 and 4 or 2,true,false)
	end
end
for _, x in {-44,44} do
	for _, z in {-43,0,43} do
		wall(circulation,"HallSide",x,z,z == 0 and 4 or 2,false,false)
	end
end

local spawn = Instance.new("SpawnLocation")
spawn.Name = "ReviewSpawn"
spawn.Size = Vector3.new(6,1,6)
spawn.Position = Vector3.new(-22,0.5,76)
spawn.Anchored = true
spawn.Neutral = true
spawn.Duration = 0
spawn.Parent = root
root.Parent = workspace
root:PivotTo(root:GetPivot() + Vector3.new(0, 1, 0))
-- Retain the blank template spawn, but use the entry for layout reviews.
local templateSpawn = workspace:FindFirstChild("SpawnLocation")
if templateSpawn and templateSpawn:IsA("SpawnLocation") then
	templateSpawn.Enabled = false
end
