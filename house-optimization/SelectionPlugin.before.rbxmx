<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4">
	<External>null</External>
	<External>nil</External>
	<Item class="Script" referent="RBX1DC73005019C48869F181C2718D9D778">
		<Properties>
			<ProtectedString name="Source"><![CDATA[local Selection = game:GetService("Selection")

local house = game.Workspace.Folder.Folder.Folder.Folder.House

local action = plugin:CreatePluginAction(
	"SelectParentsSafeV3",
	"Select Parents Safe V3",
	"Select parents, except the main House model",
	"",
	true
)

action.Triggered:Connect(function()
	local selected = Selection:Get()
	if #selected == 0 then return end

	local result = {}
	local seen = {}

	for _, object in ipairs(selected) do
		local target = object
		local parent = object.Parent

		if object:IsA("Model") then
			target = object

		elseif object:IsA("BasePart") and parent then
			-- Never promote into the main House model
			if parent ~= house then
				target = parent
			end
		end

		if target and not seen[target] then
			seen[target] = true
			table.insert(result, target)
		end
	end

	Selection:Set(result)
end)]]></ProtectedString>
			<bool name="Disabled">false</bool>
			<Content name="LinkedSource"><null></null></Content>
