		ID = id,
		Name = name,
		Difficulty = difficulty,
		PreviewSeconds = 8,
		BuildSeconds = 45 + math.min(difficulty - 1, 5) * 3,
		RequiredObjects = objects,
		DecoyObjects = {},
	}
end
